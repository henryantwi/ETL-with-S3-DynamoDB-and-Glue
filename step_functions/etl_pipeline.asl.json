{
  "Comment": "Music streaming ETL pipeline: validate files -> compute genre metrics -> load to DynamoDB -> archive raw files",
  "StartAt": "CheckRunDate",
  "States": {
    "CheckRunDate": {
      "Type": "Choice",
      "Comment": "Honor an explicit run_date (e.g. backfilling a specific day's batch); otherwise derive it from the execution start date.",
      "Choices": [
        {
          "Variable": "$.run_date",
          "StringEquals": "",
          "Next": "DeriveRunDate"
        }
      ],
      "Default": "ValidateFiles"
    },
    "DeriveRunDate": {
      "Type": "Pass",
      "Comment": "Derive run_date (YYYY-MM-DD) from execution start time so the partition label is always a valid, consistent date.",
      "Parameters": {
        "raw_bucket.$": "$.raw_bucket",
        "archive_bucket.$": "$.archive_bucket",
        "processed_bucket.$": "$.processed_bucket",
        "metrics_table.$": "$.metrics_table",
        "listening_prefix.$": "$.listening_prefix",
        "songs_prefix.$": "$.songs_prefix",
        "users_prefix.$": "$.users_prefix",
        "run_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)"
      },
      "Next": "ValidateFiles"
    },
    "ValidateFiles": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "etl-validate-files",
        "Arguments": {
          "--raw_bucket.$": "$.raw_bucket",
          "--listening_prefix.$": "$.listening_prefix",
          "--songs_prefix.$": "$.songs_prefix",
          "--users_prefix.$": "$.users_prefix"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ValidationFailed"
        }
      ],
      "Next": "TransformMetrics"
    },
    "TransformMetrics": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "etl-genre-metrics",
        "Arguments": {
          "--raw_bucket.$": "$.raw_bucket",
          "--processed_bucket.$": "$.processed_bucket",
          "--listening_prefix.$": "$.listening_prefix",
          "--songs_prefix.$": "$.songs_prefix",
          "--run_date.$": "$.run_date"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "TransformFailed"
        }
      ],
      "Next": "LoadMetrics"
    },
    "LoadMetrics": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "etl-metrics-writer",
        "Arguments": {
          "--processed_bucket.$": "$.processed_bucket",
          "--metrics_table.$": "$.metrics_table",
          "--run_date.$": "$.run_date"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "LoadFailed"
        }
      ],
      "Next": "ArchiveFiles"
    },
    "ArchiveFiles": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "etl-archive-files",
        "Arguments": {
          "--raw_bucket.$": "$.raw_bucket",
          "--archive_bucket.$": "$.archive_bucket",
          "--listening_prefix.$": "$.listening_prefix",
          "--songs_prefix.$": "$.songs_prefix",
          "--users_prefix.$": "$.users_prefix"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ArchiveFailed"
        }
      ],
      "Next": "PipelineSucceeded"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationFailed",
      "Cause": "Data validation failed — check CloudWatch Logs for etl-validate-files."
    },
    "TransformFailed": {
      "Type": "Fail",
      "Error": "TransformFailed",
      "Cause": "Genre metrics transformation failed — check CloudWatch Logs for etl-genre-metrics."
    },
    "LoadFailed": {
      "Type": "Fail",
      "Error": "LoadFailed",
      "Cause": "Metrics load to DynamoDB failed — check CloudWatch Logs for etl-metrics-writer."
    },
    "ArchiveFailed": {
      "Type": "Fail",
      "Error": "ArchiveFailed",
      "Cause": "File archival failed — check CloudWatch Logs for etl-archive-files."
    }
  }
}
